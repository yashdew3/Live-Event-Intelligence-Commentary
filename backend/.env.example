APP_NAME=Live Event Intelligence Platform
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=live_event_intelligence

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

REDIS_URL=rediss://default:password@your-db.upstash.io:6379

GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

SPORTS_DB_API_KEY=123
SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json

USE_MOCK=true

FRONTEND_URL=http://localhost:5173

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440